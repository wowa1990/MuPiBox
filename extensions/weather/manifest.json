{
  "id": "weather",
  "name": "Wetter",
  "version": "1.10.2",
  "description": "Das Wetter eines Ortes als Messuhren auf dem Display: Temperatur, Luftfeuchte, Wind, Luftdruck und Regen. Wetterserver und Ort wählst du in der Webapp.",
  "hostApi": 19,
  "resources": {},
  "api": "api.js",
  "display": "display.js",
  "icon": "icon.svg",
  "settings": {
    "provider": {
      "type": "string",
      "default": "openmeteo",
      "options": [
        "openmeteo",
        "metno"
      ]
    },
    "placeName": {
      "type": "string",
      "default": "",
      "pattern": "^.{0,120}$"
    },
    "lat": {
      "type": "number",
      "min": -90,
      "max": 90
    },
    "lon": {
      "type": "number",
      "min": -180,
      "max": 180
    },
    "tempUnit": {
      "type": "string",
      "default": "c",
      "options": [
        "c",
        "f"
      ]
    },
    "rainUnit": {
      "type": "string",
      "default": "mm",
      "options": [
        "mm",
        "inch"
      ]
    },
    "pressUnit": {
      "type": "string",
      "default": "hpa",
      "options": [
        "hpa",
        "inhg",
        "mb",
        "kpa"
      ]
    },
    "windUnit": {
      "type": "string",
      "default": "kmh",
      "options": [
        "kmh",
        "ms",
        "mph",
        "kn"
      ]
    },
    "order": {
      "type": "string",
      "default": "temp,hum,wind,dir,baro,rain",
      "pattern": "^[a-z]{2,10}(,[a-z]{2,10}){0,11}$",
      "quiet": true
    },
    "frameDesign": {
      "type": "string",
      "default": "metal",
      "options": [
        "black_metal",
        "metal",
        "shiny_metal",
        "brass",
        "steel",
        "chrome",
        "gold",
        "anthracite",
        "tilted_gray",
        "tilted_black",
        "glossy_metal"
      ],
      "quiet": true
    },
    "backgroundColor": {
      "type": "string",
      "default": "beige",
      "options": [
        "dark_gray",
        "satin_gray",
        "light_gray",
        "white",
        "black",
        "beige",
        "brown",
        "red",
        "green",
        "blue",
        "anthracite",
        "mud",
        "punched_sheet",
        "carbon",
        "stainless",
        "brushed_metal",
        "brushed_stainless",
        "turned"
      ],
      "quiet": true
    },
    "pointerType": {
      "type": "string",
      "default": "type1",
      "options": [
        "type1",
        "type2",
        "type3",
        "type4",
        "type5",
        "type6",
        "type7",
        "type8",
        "type9",
        "type10",
        "type11",
        "type12",
        "type13",
        "type14",
        "type15",
        "type16"
      ],
      "quiet": true
    },
    "pointerColor": {
      "type": "string",
      "default": "red",
      "options": [
        "red",
        "green",
        "blue",
        "orange",
        "yellow",
        "cyan",
        "magenta",
        "white",
        "gray",
        "black",
        "raith",
        "jug_green",
        "green_lcd"
